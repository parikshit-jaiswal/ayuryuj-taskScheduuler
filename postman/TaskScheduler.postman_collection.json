        {
          "name": "Get Task Results with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/results?success=true&page=1&page_size=5",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "results"],
              "query": [
                {
                  "key": "success",
