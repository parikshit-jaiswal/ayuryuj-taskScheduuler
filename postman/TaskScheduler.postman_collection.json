                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List All Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/results",
              "host": ["{{baseUrl}}"],
              "path": ["results"]
            }
          },
          "response": []
        },
        {
          "name": "List Results with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/results?success=true&date_from=2025-09-01T00:00:00Z&date_to=2025-09-30T23:59:59Z&page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["results"],
              "query": [
                {
                  "key": "success",
                  "value": "true"
                },
                {
                  "key": "date_from",
                  "value": "2025-09-01T00:00:00Z"
                },
                {
                  "key": "date_to",
                  "value": "2025-09-30T23:59:59Z"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
